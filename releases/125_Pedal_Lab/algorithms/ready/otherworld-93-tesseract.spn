; @name Tesseract
; @tagline Your playing spins a hypercube: each step one corner plays on the left and its opposite corner on the right
; @description The sixteen corners of a tesseract are sixteen ways to replay a slice of
; @description what you just played: left or right, forwards or backwards, at pitch or an
; @description octave down, from two or four slices back. On every step the cube turns to
; @description a new corner, and you hear that corner on the left and the corner opposite
; @description it on the right, which is different in every way: a slice played forwards
; @description at pitch from close by on one side is answered by a slice reversed an
; @description octave down from further back on the other. As the cube turns, the pair
; @description walks a tour of all the corners, and the tour is a pattern that repeats:
; @description sixteen steps when it turns by one corner, eight, four, and at eight corners
; @description a step it flips straight to the opposite corner. Your notes spin it: each
; @description note speeds the turning up, so the tour gets shorter and wilder while you
; @description play, and when it passes half a turn a step it snaps still and starts
; @description spinning up again; rests let it slow down. No clock needed: Time is the time
; @description between steps, like the clock pulse of the _clk version, from 0.05 s to 2 s.
; @description Slices are as long as a step up to a quarter second; on slower steps each
; @description slice stays a quarter second long and the rest of the step is a rest.
; @description Turn sets how it turns on its own (0: it rests between notes), Spin how hard
; @description each note pushes it.
; @pots Time | Turn | Spin
; @render 0.4363, 0.3, 0.4
; @time POT0 0.05 2.0 exp
; @components two-voice slicer on a Time-knob step clock, hypercube vertex walk (4 bits: side, direction, octave, depth), antipodal second voice, note-driven angular momentum with snap, periodic tours from whole-vertex strides, gated slices
;
; Otherworld vol. 1 (github.com/andreasjansson/otherworld), MIT licence.

mem	ring	32767

equ	yS	reg0		; log2(S / Smax)/16 <= 0 (latched per step)
equ	L4	reg1		; 4 S (ADDR units, latched per step)
equ	ph	reg2		; slice phasor -1 .. 0 (then on to +1, silent)
equ	V	reg3		; the vertex: -1 + index/16 (bits: W 1/8, Z 1/4, Y 1/2; X 1/16)
equ	VL	reg4		; the left voice's vertex (X = 0): V or its antipode
equ	BqL	reg5		; read slopes (1 - v)/4
equ	BqR	reg6
equ	EL	reg7		; slice ends, in units of 4 S
equ	ER	reg8
equ	flag	reg9		; onset since the last step
equ	hpf	reg10
equ	ef	reg11
equ	es	reg12
equ	w	reg13
equ	t	reg14
equ	M	reg15		; momentum 0 .. 1/2 (wraps)
equ	n4	reg16		; time since the step began, 4 s units (2^-17 a sample)
equ	U	reg17		; 2^-15: one sample of address
equ	T4	reg18		; the step period T, 4 s units (latched per step)

; ---- init: one sample of address
	skp	run, i_done
	or	$000100
	wrax	U, 0
i_done:
; ---- the ring (the last second, live) and onsets: flag = strongest onset since the last step
	rdax	adcl, 0.25
	rdax	adcr, 0.25
	wra	ring, 1.0
	rdfx	hpf, 0.25
	wrhx	hpf, -1.0
	absa
	rdfx	ef, 0.012
	wrax	ef, 1.0
	rdfx	es, 0.001
	wrhx	es, -1.6
	skp	gez, o_pos
	clr
o_pos:	and	$7FFF00			; below 2^-15 reads as 0
	maxx	flag, 1.0
	wrax	flag, 0
; ---- slice phasor: -1 .. 0 across the slice, 2^-15 / S a sample (saturates at +1 after)
	ldax	yS
	sof	-1.0, -0.8125
	exp	1.0175171387, 0		; 0.25/Smax x 2^(16(-yS - 13/16))
	rdax	ph, 1.0
	wrax	ph, 0
; ---- step clock: n4 counts whole samples (2^-17 each, so 2 s fit); a step fires every T
	ldax	n4
	rdax	U, 0.25
	wrax	n4, 1.0
	rdax	U, 0.125		; (rounds the step to the nearest whole sample)
	rdax	T4, -1.0
	skp	neg, nostep
	clr
	wrax	n4, 0
	sof	0, -1.0
	wrax	ph, 0
; a step: read the Time knob, T = 0.05 x 40^Time s; y = log2(T / Smax)/16,
; Smax = 0.2 x 2^(19/64) s (so the offset is exact)
	ldax	pot0
	sof	0.6652410119, 0		; 2 log2(40)/16 x Time (x2: a finer coefficient, still below 1)
	sof	0.5, -0.1435546875
	wrax	t, 1.0
	sof	1.0, -0.25
	exp	0.9827844289, 0		; T / 4 = 4 Smax 2^(16 (y - 1/4))
	wrax	T4, 0
; the slice: S = min(T, Smax)
	ldax	t
	skp	neg, s_ok
	clr
s_ok:	wrax	yS, 1.0
	exp	0.9827844289, 0		; 4 S = 4 Smax 2^(16 yS)
	wrax	L4, 0
; notes since the last step spin it up (momentum M, -3 % a step); past half a turn
; a step it snaps still (AND wraps M to 0) and spins up again. The vertex turns by
; Turn + M (M up to 8 vertices: nearly the antipode every step)
	ldax	flag
	skp	zro, s_walk
	ldax	pot2
	sof	0.06, 0.015		; Spin: momentum per note
s_walk:	rdax	M, 0.97
	and	$3FFFFF
	wrax	M, 1.0
	rdax	pot1, 0.4375		; Turn: 0 .. 7 vertices a step
	and	$780000			; whole vertices: a periodic tour (stride 1: 16 steps .. 8: 2)
	rdax	V, 1.0
	or	$800000			; (index mod 16)
	wrax	V, 1.0
; left voice: the vertex with X = 0 (V, or its antipode V XOR all four bits)
	and	$080000
	skp	zro, l_v
	ldax	V
	xor	$780000
	skp	0, l_set
l_v:	ldax	V
l_set:	wrax	VL, 1.0
; decode: Bq = 0.375 Y + 0.125 W (straight, octave down, reversed an octave down, reversed),
; the antipode's 0.5 - Bq; ends 2 or 4 slices back by Z
	and	$100000
	wrax	t, 0
	ldax	VL
	and	$400000
	sof	0.75, 0
	rdax	t, 1.0
	wrax	BqL, 1.0
	sof	-1.0, 0.5
	wrax	BqR, 0
	ldax	VL
	and	$200000
	sof	1.99, 0.5
	wrax	EL, 1.0
	sof	-1.0, 0.99755859375
	sof	1.0, 0.5
	wrax	ER, 0
	wrax	flag, 0
nostep:
; ---- window sat(32 u (G - u)), u = ph + 1, G = 0.87 (Gate 0.8 fixed)
	ldax	ph
	sof	1.0, 0.999
	wrax	t, -1.0
	sof	1.0, 0.8701171875
	mulx	t
	skp	gez, w_ok
	clr
w_ok:	log	1.0, 0.3125
	exp	1.0, 0
	wrax	w, 0
; ---- voices: left = the vertex, right = its antipode
	ldax	ph
	mulx	BqL
	rdax	EL, 1.0
	mulx	L4
	wrax	addr_ptr, 0
	rmpa	1.9
	mulx	w
	wrax	dacl, 0
	ldax	ph
	mulx	BqR
	rdax	ER, 1.0
	mulx	L4
	wrax	addr_ptr, 0
	rmpa	1.9
	mulx	w
	wrax	dacr, 0
