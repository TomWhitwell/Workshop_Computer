; @name Quantum Tunneling_clk
; @tagline Every beat throws your last beat at a wall: it bounces back reversed, or tunnels through to the far side an octave down, until your notes wear the barrier away
; @description Each step of your clock throws the step you just played at a barrier,
; @description the left wall and the right wall in turn. Most of the time it bounces: the
; @description step comes straight back reversed on that wall's side, so the beats ping-pong
; @description left and right as reversed echoes. Sometimes it tunnels: the bounce never
; @description comes, and instead the step appears on the far side an octave down and late,
; @description playing its beginning slowly, breaking the ping-pong. Loud attacks tunnel more
; @description easily, and every note wears the barrier thinner, so as you play the deep
; @description ghosts get more and more frequent. When the barrier is gone it collapses:
; @description for a few beats everything floods through, octave-down ghosts that fall
; @description back in and tunnel again, an octave lower each time, then a fresh barrier
; @description goes up and the reversed ping-pong returns. Rattle throws the bounces back in,
; @description so particles keep rattling between the walls, reversing again with each bounce.
; @clock
; @pots Barrier | Erode | Rattle
; @render 0.5, 0.35, 0.4
; @components clock-locked step slicer, alternating walls, reversed bounce vs octave-down tunnelling chosen by a random draw against the tunnelling probability, attack-strength energy, note-eroded barrier with collapse and flood, feedback rattle with flood cascade, hard stereo throws
;
; Otherworld vol. 1 (github.com/andreasjansson/otherworld), MIT licence.

mem	ring	32767

equ	clkhp	reg0		; clock detector: low-pass state
equ	clkin	reg1		; free (the factory clock block's conditioned sample)
equ	clkst	reg2		; clock state: -0.25 high, -0.5 low (armed)
equ	clkprev	reg3
equ	clkcnt	reg4
equ	clkper	reg5
equ	Us	reg6		; the step (address units), the period folded into [74, 297) ms
equ	cdn	reg7		; countdown through the step Us .. 0
equ	hpf	reg8
equ	ef	reg9
equ	es	reg10
equ	flag	reg11		; the strongest attack in this step (0: none)
equ	d	reg12		; barrier thickness 0 .. 1
equ	r	reg13		; random 0 .. 1/4
equ	tun	reg14		; this step's particle tunnelled (1) or bounced (0)
equ	sg	reg15		; the wall it hits: 0.999 left, 0 right (alternates every step)
equ	side	reg16		; where this step sounds: 0.999 left, 0 right
equ	fl	reg17		; flood: decays x 0.75 a step
equ	w	reg18
equ	t	reg19
equ	a	reg20		; this step's voice
equ	clkinc	reg21		; 2^-18, the clock counter's step (set at load)

; ---- clock: rising-edge detector, then the factory count
	ldax	adcr
	rdfx	clkhp, 0.06		; low-pass of ADCR, tau ~0.5 ms
	wrax	clkhp, -1.0
	rdax	adcr, 1.0		; d = ADCR - low-pass: the recent rise
	sof	1.0, -0.1875		; high at d >= 0.1875
	skp	neg, c_lo
	sof	0, -0.25		; state high
	wrax	clkst, 0
	skp	zro, c_hi
c_lo:	sof	1.0, 0.125		; d - 0.0625: below it the input re-arms; between, hold
	skp	gez, c_hi
	sof	0, -0.5			; state low (armed)
	wrax	clkst, 0
c_hi:	ldax	clkprev			; latch on low -> high
	rdax	clkst, -1.0
	skp	neg, c_latch
	ldax	clkcnt
	rdax	clkinc, 1.0
	and	$3FFFFF
	wrax	clkcnt, 0
	skp	zro, c_done
c_latch: ldax	clkcnt
	wrax	clkper, 0
	wrax	clkcnt, 0
	wrax	cdn, 0			; the beat: a step starts on this very sample
c_done:	ldax	clkst
	wrax	clkprev, 0
	skp	run, c_run		; at load (a slot change keeps the previous program's registers):
	or	$000020
	wrax	clkinc, 0
	sof	0, 0.999
	wrax	d, 0			; a thick barrier to start
	wrax	sg, 0			; the walls in order (a stray value would mix the sides for good)
c_run:
; ---- the step: the clock period folded by whole octaves into [74, 297) ms
	or	$000080			; + 4 samples (2^-16; ACC is 0 here), so the clock edge, not the
	rdax	clkper, 1.0		; countdown, starts each step
	log	1.0, 0.296875
	or	$F00000
	exp	0.2973, 0
	wrax	Us, 0
; ---- the ring: the input, plus the voice thrown back in (Rattle)
	ldax	pot2			; Rattle (a flood rattles at full)
	maxx	fl, 1.0
	wrax	t, 0
	rdax	a, 0.26			; (ACC is 0 here)
	rdax	adcl, -0.1
	mulx	t
	rdax	adcl, 0.5
	wra	ring, 0
	rdax	adcl, 0.5
; ---- onsets: flag = the strongest attack in this step (fast env above 1.6 x slow)
	rdfx	hpf, 0.25
	wrhx	hpf, -1.0
	absa
	rdfx	ef, 0.012
	wrax	ef, 1.0
	rdfx	es, 0.001
	wrax	es, 1.6
	rdax	ef, -1.0
	skp	gez, no_on
	maxx	flag, 1.0
	wrax	flag, 0
no_on:
; ---- step countdown (exact: the step is 4 samples longer than the clock, so the edge wins)
	clr
	or	$FFFF00			; -2^-15: one sample
	rdax	cdn, 1.0
	wrax	cdn, 1.0
	skp	gez, nostep
	rdax	Us, 1.0
	wrax	cdn, 0
; a step: last step's particle hits a wall, the left and right walls in turn. It
; tunnels with probability T = 2^(16 (E - (0.1 + 0.4 Barrier) d)), E its attack;
; else it bounces back
	ldax	r			; random: x' = 1.9 x + 0.15 mod 1/4
	sof	1.9, 0.15
	and	$1FFFFF
	wrax	r, 0
	ldax	sg			; the other wall
	sof	-1.0, 0.999
	wrax	sg, 0
	ldax	pot0
	sof	-0.4, -0.1
	mulx	d
	rdax	flag, 1.0
	exp	1.0, 0			; T
	sof	-0.25, 0
	rdax	r, 1.0
	rdax	fl, -1.0		; a flood: everything tunnels
	and	$800000
	sof	-1.0, 0
	wrax	tun, 1.0		; 1: tunnelled
	rdax	sg, -1.0
	absa
	wrax	side, 0			; a bounce sounds at the wall, a tunnel beyond the far wall
; notes erode the barrier (Erode); when it is gone, a flood, and it is rebuilt
	ldax	flag
	skp	zro, nonote
	ldax	pot1
	sof	-0.1, -0.01
	rdax	d, 1.0
	wrax	d, 1.0
	skp	gez, nonote
	sof	0, 0.999		; collapse
	wrax	fl, 1.0
	wrax	d, 0
nonote:	ldax	fl
	sof	0.75, 0
	wrax	fl, 0
	wrax	flag, 0
nostep:
; ---- window: sat(512 cdn (Us - cdn))
	ldax	Us
	rdax	cdn, -1.0
	wrax	t, 1.0			; t: time into the step
	mulx	cdn
	log	1.0, 0.5625
	exp	1.0, 0
	wrax	w, 0
; ---- the voice: a bounce plays the last step reversed (offset 2t); a tunnel plays
;      its first half an octave down (offset Us + t/2)
	rdax	t, -1.5			; (ACC is 0 here)
	rdax	Us, 1.0
	mulx	tun
	rdax	t, 1.99993896484375
	wrax	addr_ptr, 0
	rmpa	1.99
	mulx	w
	wrax	a, 1.0
	sof	1.15, 0			; make-up
	mulx	side
	wrax	dacl, -1.0
	rdax	a, 1.15
	wrax	dacr, 0
