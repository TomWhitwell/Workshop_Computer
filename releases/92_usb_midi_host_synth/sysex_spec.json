{
  "name": "UsbMidiHostSynth",
  "version": 1,
  "firmware": {
    "major": 0,
    "minor": 9,
    "patch": 0
  },
  "transport": {
    "type": "usb_midi_sysex",
    "manufacturer_id": "0x7D",
    "device_id": "0x79",
    "frame": [
      "0xF0",
      "manufacturer_id",
      "device_id",
      "command",
      "payload (optional)",
      "0xF7"
    ],
    "commands": {
      "preview_config": "0x01",
      "save_config_flash": "0x02",
      "read_config": "0x03",
      "card_id": "0x04",
      "panel_state": "0x05",
      "panel_stream": "0x06",
      "read_maps": "0x07",
      "write_maps_flash": "0x08",
      "set_perf_ram": "0x09",
      "learn_notify": "0x0A"
    }
  },
  "data_layout": {
    "CardConfig": {
      "raw_bytes": 8,
      "fields": [
        { "name": "channelA", "type": "u8", "description": "Voice A MIDI channel (0-15)" },
        { "name": "channelB", "type": "u8", "description": "Voice B MIDI channel (0-15)" },
        { "name": "bendSemitones", "type": "u8", "range": [1, 12] },
        { "name": "flags", "type": "u8", "description": "bit0 = MIDI activity LED" },
        { "name": "reserved", "type": "u8[3]" },
        { "name": "marker", "type": "u8", "default": "0x4D" }
      ]
    },
    "ExtConfig": {
      "raw_bytes": 62,
      "fields": [
        { "name": "marker", "type": "u8", "default": "0x58" },
        { "name": "audioVoice", "type": "u8", "range": [0, 120], "description": "121-patch voice matrix index" },
        { "name": "arpMode", "type": "u8", "range": [0, 8] },
        { "name": "reverbWet", "type": "u8", "range": [0, 127] },
        { "name": "attack", "type": "u8", "range": [0, 127] },
        { "name": "decay", "type": "u8", "range": [0, 127] },
        { "name": "sustain", "type": "u8", "range": [0, 127] },
        { "name": "releaseAmp", "type": "u8", "range": [0, 127] },
        { "name": "cutoff", "type": "u8", "range": [0, 127] },
        { "name": "pwmWidth", "type": "u8", "range": [0, 127] },
        {
          "name": "slots",
          "type": "MapSlot[13]",
          "fields": [
            { "name": "sourceType", "type": "u8", "enum": ["none", "cc", "note", "knobX", "knobY"] },
            { "name": "channel", "type": "u8", "description": "0-15 or 16 = Omni" },
            { "name": "ccOrNote", "type": "u8" },
            { "name": "pad", "type": "u8" }
          ]
        }
      ]
    },
    "PanelStatePayload": {
      "command": "0x05",
      "fields": [
        { "name": "main", "type": "u14", "description": "Main knob, quantized to 32-step" },
        { "name": "x", "type": "u14" },
        { "name": "y", "type": "u14" },
        { "name": "switch", "type": "u8", "range": [0, 2] },
        { "name": "appMode", "type": "u8", "enum": ["play", "setup"] },
        { "name": "setupSlot", "type": "u8" },
        { "name": "audioVoice", "type": "u8" },
        { "name": "arpMode", "type": "u8" },
        { "name": "reverbWet", "type": "u8" },
        { "name": "attack", "type": "u8" },
        { "name": "decay", "type": "u8" },
        { "name": "sustain", "type": "u8" },
        { "name": "releaseAmp", "type": "u8" },
        { "name": "cutoff", "type": "u8" },
        { "name": "pwmWidth", "type": "u8" },
        { "name": "setupSlotPending", "type": "u8" },
        { "name": "reserved", "type": "u8", "default": 127 }
      ]
    },
    "SetPerfPayload": {
      "command": "0x09",
      "fields": [
        { "name": "audioVoice", "type": "u8" },
        { "name": "arpMode", "type": "u8" },
        { "name": "reverbWet", "type": "u8" },
        { "name": "attack", "type": "u8", "optional": true },
        { "name": "decay", "type": "u8", "optional": true },
        { "name": "sustain", "type": "u8", "optional": true },
        { "name": "releaseAmp", "type": "u8", "optional": true },
        { "name": "cutoff", "type": "u8", "optional": true },
        { "name": "pwmWidth", "type": "u8", "optional": true }
      ]
    }
  }
}
