{
  "name": "workshop-computer-sitegen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run check-curation",
    "build": "node ./src/build.js",
    "dev": "npm run build -- --preview && vite --config vite.config.js",
    "validate-info": "node ./src/validate/cli.js",
    "check-curation": "node ./src/curation/cli.js check",
    "sync-curation": "node ./src/curation/cli.js sync",
    "setup-panel-renderer": "playwright install --with-deps chromium",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "ajv": "^8.20.0",
    "marked": "^12.0.2",
    "monaco-editor": "^0.52.2",
    "monaco-yaml": "^5.5.1",
    "sanitize-html": "^2.17.5",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.61.1",
    "vite": "^7.3.6"
  }
}
